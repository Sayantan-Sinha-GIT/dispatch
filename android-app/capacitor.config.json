{
  "appId": "com.dispatch.app",
  "appName": "Dispatch",
  "webDir": "www",
  "server": {
    "url": "https://dispatch-delivery.vercel.app",
    "androidScheme": "https"
  },
  "android": {
    "appendUserAgent": "DispatchAndroid",
    "backgroundColor": "#f2f0f8"
  },
  "plugins": {
    "SocialLogin": {
      "providers": {
        "google": true,
        "facebook": false,
        "apple": false,
        "twitter": false
      },
      "logLevel": 1
    },
    "SystemBars": {
      "insetsHandling": "native",
      "style": "LIGHT",
      "initialViewportFitValueHint": "cover"
    }
  }
}
